---
import Document from '../../layouts/Document.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';
import Snippet from '../../components/Snippet.astro';
import { INTEROP, PRIOR_ART, SURFACES, VERSION } from '../../lib/levels';
import { localeParams, getLocale, levelsIn, treeIn, edgeCasesIn, localePath } from '../../lib/i18n';

export const getStaticPaths = localeParams;

const { lang } = Astro.props;
const t = getLocale(lang);
const LEVELS = levelsIn(lang);
const TREE = treeIn(lang);
const CASES = edgeCasesIn(lang);
const L = (p: string) => localePath(lang, p);
---

<Document sections={[
    { href: '#procedure', label: t.ui.specPage.procedure },
    { href: '#surfaces', label: t.ui.specPage.surfaces },
    { href: '#edge-cases', label: t.ui.specPage.edgeCases },
    { href: '#challenge', label: t.ui.specPage.challengeH },
    { href: '#interop', label: t.ui.specPage.interop },
    { href: '#machine', label: t.ui.specPage.machine },
    { href: '#prior-art', label: t.ui.specPage.priorArt }
  ]} navLabel={t.ui.specPage.eyebrow}
  lang={lang}
  path="/spec"
  title={`${t.ui.specPage.eyebrow} — AI Usage Scale`}
  description={t.ui.specPage.standfirst}
  card="spec"
  breadcrumb={[[t.ui.specPage.eyebrow, '/spec']]}
  schema={[
    {
      '@type': 'TechArticle',
      '@id': `https://usagescale.org${L('/spec')}#article`,
      headline: `AI Usage Scale — ${t.ui.specPage.eyebrow}`,
      inLanguage: lang,
      version: VERSION,
      about: { '@id': 'https://usagescale.org/#scale' },
      license: 'https://creativecommons.org/licenses/by/4.0/',
    },
  ]}
>
  <TranslationNotice slot="notice" lang={lang} path="/spec" />

  <header slot="header" class="top prose">
    <p class="label">{t.ui.specPage.eyebrow} · {VERSION}</p>
    <h1>{t.ui.specPage.h1}</h1>
    <p class="standfirst">{t.ui.specPage.standfirst}</p>
  </header>

  <section id="procedure">
    <h2>{t.ui.specPage.procedure}</h2>
    <p class="prose">{t.ui.specPage.procedureLede}</p>
    <ol class="procedure-list">
      {TREE.map((s: any, i: number) => <li>
        <span class="step" aria-hidden="true">{i + 1}</span>
        <div>
          <p class="question">{s.question}</p>
          <dl class="step-outcomes">
            <div><dt>{t.ui.specPage.yesCol}</dt><dd>{typeof s.yes === 'number' ? <a href={L('/' + s.yes)}>{s.yes}</a> : t.ui.specPage.next}</dd></div>
            <div><dt>{t.ui.specPage.noCol}</dt><dd>{typeof s.no === 'number' ? <a href={L('/' + s.no)}>{s.no}</a> : t.ui.specPage.next}</dd></div>
          </dl>
        </div>
      </li>)}
    </ol>
  </section>

  <section id="surfaces">
    <h2>{t.ui.specPage.surfaces}</h2>
    <p class="prose">{t.surfaces.note}</p>
    <p class="prose"><strong>{t.ui.specPage.headlineRule}</strong> {t.surfaces.headlineRule}</p>
    <p class="prose">{t.ui.specPage.recognised} {SURFACES.keys.map((k: string) => <code>{k}</code>)}</p>
    <Snippet label="JSON" ui={t.ui.level} code={`{
  "aiUsageScale": "1.0",
  "level": 3,
  "surfaces": { "text": 3, "image": 5, "audio": 0 }
}`} />
  </section>

  <section id="edge-cases">
    <h2>{t.ui.specPage.edgeCases}</h2>
    <p class="prose">{t.ui.specPage.edgeLede}</p>
    <dl class="cases">
      {
        CASES.map((c: any) => (
          <div class="case" id={c.anchor}>
            <dt>{c.case}</dt>
            <dd>
              <p class="rule-txt">{c.rule}</p>
              {c.why && <p class="why">{c.why}</p>}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="challenge">
    <h2>{t.ui.specPage.challengeH}</h2>
    <p class="prose">{t.ui.specPage.challengeA}</p>
    <p class="prose">{t.ui.specPage.challengeB}</p>
  </section>

  <section id="interop">
    <h2>{t.ui.specPage.interop}</h2>
    <p class="prose">{t.ui.specPage.interopLede}</p>

    {/* Interop copy stays in English: it is a factual statement about other people's
        specifications, and paraphrasing it in twenty languages is twenty chances to
        misstate what someone else's standard does. */}
    {
      Object.values(INTEROP).map((v: any) => (
        <div class="interop" lang="en" dir="ltr">
          <h3><a href={v.url}>{v.name}</a></h3>
          <p lang="en">{v.relationship}</p>
        </div>
      ))
    }

    <h3 class="mt">{t.ui.specPage.mapping}</h3>
    <table class="levels mapping-table" lang="en" dir="ltr">
      <thead>
        <tr><th scope="col">#</th><th scope="col" lang="en">Text disclosure candidate</th><th scope="col">IPTC candidate</th></tr>
      </thead>
      <tbody>
        {
          LEVELS.map((l) => (
            <tr>
              <td class="n">{l.id}</td>
              <td data-label="ai-disclosure">{l.mappings.w3cAiDisclosure ? <code>{l.mappings.w3cAiDisclosure}</code> : <span lang="en">Check scope and review</span>}</td>
              <td data-label="IPTC"><code>{l.mappings.iptcDigitalSourceType.split('/').pop()}</code></td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="caveat prose">{t.ui.specPage.lossy}</p>
    <p class="prose" lang="en">The Community Group's 9 October 2026 report uses
      <code>human-only</code>, <code>ai-assisted</code> and <code>ai-autonomous</code> for text.
      Levels 1 and 2 do not determine a value without the text's scope and actual review state.
      A Level 3 candidate requires the meaningful review in its full definition. Generic scale
      snippets omit the separate CG declaration so that publishers can assess it independently.</p>
  </section>

  <section id="machine">
    <h2>{t.ui.specPage.machine}</h2>
    <p class="prose">{t.ui.specPage.machineLede}</p>
    <p class="prose">{t.ui.home.standards}</p>
    <p class="prose">
      <a href={L('/levels.json')} class="mono">GET {L('/levels.json')}</a> · CC0
    </p>
    <Snippet label="HTML" ui={t.ui.level} code={`<meta name="ai-usage" content="3">
<meta name="ai-usage-standard" content="https://usagescale.org">

<link rel="ai-disclosure" href="https://usagescale.org/3">`} />

    <p class="prose">{t.ui.specPage.wellKnown}</p>
    <Snippet label="JSON · /.well-known/ai-disclosure.json" ui={t.ui.level} code={`{
  "aiUsageScale": "1.0",
  "level": 3,
  "surfaces": { "text": 3, "image": 0 },
  "definition": "https://usagescale.org/3"
}`} />
    <div id="aiUsageLevel" lang="en" dir="ltr" class="prose">
      <h3>Project-defined JSON-LD property</h3>
      <p><code>https://usagescale.org/spec#aiUsageLevel</code> identifies this project's
        proposed integer property, with values 0–5. Map it explicitly in a JSON-LD context.
        It is not a property in the Schema.org vocabulary, and Google Search has no
        documented feature for displaying these levels. <code>additionalProperty</code>
        does not have <code>CreativeWork</code> in its published domain and is not the pattern we recommend.</p>
      <p>The optional <code>/.well-known/ai-disclosure.json</code> location is also a project convention;
        it is not a registered well-known URI or a discovery guarantee. It describes a publisher's
        declared scope, not a verified process.</p>
    </div>
  </section>

  <section id="prior-art">
    <h2>{t.ui.specPage.priorArt}</h2>
    <p class="prose">{t.ui.specPage.priorLede}</p>
    {
      PRIOR_ART.map((p: any) => (
        <div class="interop" lang="en" dir="ltr">
          <h3><a href={p.url}>{p.name}</a></h3>
          {p.authors && <p class="authors">{p.authors}</p>}
          <p lang="en">{p.note}</p>
        </div>
      ))
    }
  </section>
</Document>

<style>
  .mt { margin-top: 2.5rem; }

  .cases { margin: 1.5rem 0; }
  .case { border-top: 1px solid var(--rule-soft); padding: 1.25rem 0; scroll-margin-top: 2rem; }
  .case:last-child { border-bottom: 1px solid var(--rule-soft); }
  .case dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .case dd { margin: 0; }
  .rule-txt { margin: 0 0 0.4rem; }
  .why { margin: 0; font-size: 0.9375rem; color: var(--ink-mid); font-style: italic; }

  .interop { margin: 1.75rem 0; }
  .interop h3 { margin: 0 0 0.35rem; }
  .interop p { margin: 0; color: var(--ink-mid); font-size: 1.0625rem; }
  .authors { font-size: 0.875rem !important; font-family: var(--mono); margin-bottom: 0.35rem !important; }

  .caveat { color: var(--ink-mid); font-size: 1.0625rem; }
  .mono { font-family: var(--mono); font-size: 0.875rem; }
</style>
