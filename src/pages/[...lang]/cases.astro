---
import Document from '../../layouts/Document.astro';
import { CASES } from '../../data/cases';
import { localeParams, localePath } from '../../lib/i18n';
export const getStaticPaths = localeParams;
const { lang } = Astro.props;
const L = (p: string) => localePath(lang, p);
---
<Document sections={[...CASES.map(c => ({ href: '#' + c.slug, label: c.level + ' · ' + c.title })), { href: '#boundary', label: 'Open boundary' }]} navLabel="Worked examples" lang={lang} path="/cases" translated={false}
  title="Worked examples — AI Usage Scale"
  description="Six illustrative workflows, classified against the AI Usage Scale definitions."
  breadcrumb={[[ 'Worked examples', '/cases' ]]}>
  <header slot="header" class="prose">
    <p class="label">Applying the definitions</p>
    <h1>Worked examples</h1>
    <p class="standfirst">A number becomes useful when the process behind it is clear.</p>
    <p>These are illustrative scenarios, not claims about named publications or evidence of adoption.
      Compare the actual work with the <a href={L('/spec')}>full specification</a>; a short example cannot cover every boundary.</p>
  </header>
  <div class="examples">{CASES.map((c) => <article id={c.slug}>
    <a class="number" href={L('/' + c.level)} aria-label={`Level ${c.level}`}>{c.level}</a>
    <div><h2>{c.title}</h2><p>{c.process}</p><p class="reason">{c.reasoning}</p></div>
  </article>)}</div>
  <aside id="boundary" class="prose">
    <h2>An unresolved boundary</h2>
    <p>Supplying original human notes does not establish that a generated work was reviewed.
      The current decision tree can suggest Level 3 without checking review, while its definition
      requires meaningful review. Treat that result as provisional and describe the process
      explicitly when review is missing.</p>
    <p>Deterministic templates and older automated reporting systems are not automatically
      generative AI. Establish what the system does before assigning an AI Usage level.</p>
    <p>Public references and verified uses belong in <a href={L('/project')}>Project status</a>.
      To submit a real classification case, include a description of the workflow and primary evidence
      in a <a href="https://github.com/karauda/ai-usage-scale/issues">GitHub issue</a>.</p>
  </aside>
</Document>
<style>
  .examples { margin: 0; }
  article { display: grid; grid-template-columns: 5rem minmax(0, 42rem); gap: 2rem; padding: 2rem 0; border-top: 1px solid var(--rule); }
  .number { font-family: var(--serif); font-size: 4.5rem; line-height: 1; text-decoration: none; color: var(--ink); }
  article h2 { font-size: 1.8rem; margin-top: 0; }
  article p { margin: .7rem 0; }
  .reason { color: var(--ink-mid); }
  aside { margin: 3rem 0; padding-top: 2rem; border-top: 1px solid var(--rule); }
  @media (max-width: 40rem) { article { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; } .number { font-size: 3rem; } }
</style>
