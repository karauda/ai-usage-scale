---
import { getLocale, localePath } from '../lib/i18n';
import { VERSION } from '../lib/levels';
interface Props { lang: string }
const { lang } = Astro.props;
const t = getLocale(lang);
const h = t.ui.home;
---

<section class="hero" aria-labelledby="hero-h">
  <div class="hero-meta label"><span>{h.status}</span><span>v{VERSION} / CC0</span></div>
  <div class="hero-grid">
    <div>
      <h1 id="hero-h">{h.h1}</h1>
      <p class="hero-sub">{h.intro}</p>
      <div class="hero-actions">
        <a href={localePath(lang, '/find-your-level')} class="button">{t.ui.hero.cta}<span class="arrow" aria-hidden="true">↗</span></a>
        <a class="text-link" href={localePath(lang, '/spec')}>{t.ui.foot.spec}</a>
      </div>
    </div>
    <aside class="range" aria-label={t.ui.scalePage.eyebrow}>
      <div class="range-numbers" dir="ltr" aria-hidden="true">0<span>—</span>5</div>
      <div class="range-index" dir="ltr" aria-hidden="true">{[0, 1, 2, 3, 4, 5].map((n) => <span>{n}</span>)}</div>
      <p>{h.rangeNote}</p>
      <a class="text-link" href="#six-levels">{t.ui.level.allLevels}<span class="arrow" aria-hidden="true"> ↓</span></a>
    </aside>
  </div>
</section>

<style>
  .hero { padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(3rem, 6vw, 5.5rem); }
  .hero-meta { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 3.5rem; }
  .hero-meta span:first-child { color: var(--accent); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 5rem; align-items: end; }
  h1 { font-size: clamp(2.5rem, 6vw, 6rem); line-height: 1.04; max-width: 14ch; margin-bottom: 1.75rem; overflow-wrap: anywhere; }
  .hero-sub { font-size: 1.0625rem; color: var(--ink-mid); max-width: 47ch; margin: 0 0 2rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 1.75rem; }
  .range { border-inline-start: 1px solid var(--rule); padding-inline-start: 2.5rem; padding-bottom: 0.25rem; }
  .range-numbers { font-family: var(--serif); font-size: clamp(4rem, 7.8vw, 8rem); line-height: 1.1; letter-spacing: -0.09em; white-space: nowrap; }
  .range-numbers span { font-size: 0.65em; margin: 0 0.08em; color: var(--accent); }
  .range-index { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem; padding-top: 1.2rem; margin-top: 0.6rem; border-top: 1px solid var(--rule); font-family: var(--mono); font-size: 0.75rem; color: var(--ink-soft); }
  .range p { margin: 1.5rem 0 0.75rem; color: var(--ink-mid); font-size: 0.875rem; max-width: 29ch; }
  :global(html:is([lang='zh'], [lang='ja'], [lang='ko'])) h1 { max-width: 9em; font-size: clamp(2.75rem, 5vw, 4.75rem); line-height: 1.2; }
  @media (max-width: 50rem) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .hero-meta { margin-bottom: 2.5rem; }
    h1 { max-width: 17ch; }
    .range { border-inline-start: 0; border-top: 1px solid var(--rule); padding: 1.5rem 0 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.5rem 2rem; align-items: center; }
    .range-numbers { grid-row: 1 / 4; font-size: 4rem; }
    .range-index { margin: 0; padding: 0; border: 0; }
    .range p { margin: 0; max-width: none; }
  }
  @media (max-width: 25rem) { .range { gap: 0.5rem 1.25rem; } .range-numbers { font-size: 3.3rem; } }
</style>
