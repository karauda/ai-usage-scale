---
import { getLocale, localePath, DEFAULT_LANG } from '../lib/i18n';
interface Props { lang: string; path: string }
const { lang, path } = Astro.props;
const t = getLocale(lang);
const machine = t.translation?.by === 'machine';
---

{t.translation && (
  <aside class="tn" dir={t.dir}>
    <p><span class="tn-mark" aria-hidden="true">{machine ? 'MT' : 'HR'}</span>
      {machine ? t.ui.lang.machineNotice : t.ui.lang.humanNotice}</p>
    <div class="tn-links">
      <a href={localePath(DEFAULT_LANG, path)} hreflang={DEFAULT_LANG} lang={DEFAULT_LANG}>{t.ui.lang.readEnglish}</a>
      <a href={`https://github.com/karauda/ai-usage-scale/blob/main/src/i18n/${lang}.json`}>{t.ui.lang.improve}</a>
    </div>
  </aside>
)}

<style>
  .tn { margin: 1.5rem 0 2rem; padding: 1rem 0; border-top: 1px solid var(--rule-soft); font-size: 0.8125rem; color: var(--ink-mid); }
  .tn p { margin: 0 0 0.5rem; }
  .tn-mark { font-family: var(--mono); font-size: 0.6875rem; color: var(--accent); margin-inline-end: 0.75rem; }
  .tn-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
</style>
