---
import { levelsIn, localePath, alternates, DEFAULT_LANG, getLocale } from '../lib/i18n';
import { VERSION } from '../lib/levels';
interface Props {
  lang?: string;
  path: string;
  title: string;
  description: string;
  card?: string;
  level?: number;
  aiDisclosure?: string;
  breadcrumb?: Array<[string, string]>;
  schema?: object[];
  translated?: boolean;
}
const { lang = DEFAULT_LANG, path, title, description, card = 'default', level,
  aiDisclosure, breadcrumb = [], schema = [], translated = true } = Astro.props;
const canonicalLang = translated ? lang : DEFAULT_LANG;
const t = getLocale(canonicalLang);
const levels = levelsIn(canonicalLang);
const SITE = 'https://usagescale.org';
const url = `${SITE}${localePath(canonicalLang, path)}`;
const image = `${SITE}/og/${card}.png`;
const alts = translated ? alternates(path) : [];
const OG_LOCALE: Record<string, string> = {
  ar: 'ar_AR', bn: 'bn_BD', de: 'de_DE', en: 'en_US', es: 'es_ES', fa: 'fa_IR',
  fr: 'fr_FR', hi: 'hi_IN', id: 'id_ID', it: 'it_IT', ja: 'ja_JP', ko: 'ko_KR',
  nl: 'nl_NL', pl: 'pl_PL', pt: 'pt_BR', ru: 'ru_RU', sv: 'sv_SE', th: 'th_TH',
  tr: 'tr_TR', uk: 'uk_UA', vi: 'vi_VN', zh: 'zh_CN',
};
const ogLocale = (code: string) => OG_LOCALE[code] ?? 'en_US';
const setId = canonicalLang === DEFAULT_LANG ? `${SITE}/#scale` : `${SITE}/${canonicalLang}/scale#vocabulary`;
const term = (l: typeof levels[number]) => ({
  '@type': 'DefinedTerm',
  '@id': `${SITE}${localePath(canonicalLang, `/${l.id}`)}#term`,
  termCode: String(l.id),
  name: l.name,
  description: path === '/' ? l.oneLine : `${l.oneLine} ${l.definition}`,
  url: `${SITE}${localePath(canonicalLang, `/${l.id}`)}`,
  inDefinedTermSet: { '@id': setId },
});
const termSet = {
  '@type': 'DefinedTermSet', '@id': setId, name: 'AI Usage Scale',
  description: t.ui.home.scaleNote,
  url: `${SITE}${localePath(canonicalLang, '/scale')}`,
  inLanguage: canonicalLang, version: VERSION,
  license: 'https://creativecommons.org/publicdomain/zero/1.0/',
  ...(['/', '/scale'].includes(path) ? { hasDefinedTerm: levels.map(term) } : {}),
};
const website = {
  '@type': 'WebSite', '@id': `${SITE}/#site`, url: `${SITE}/`, name: 'AI Usage Scale',
  inLanguage: canonicalLang,
  license: 'https://creativecommons.org/licenses/by/4.0/',
};
const page = {
  '@type': 'WebPage', '@id': `${url}#page`, url, name: title, description,
  inLanguage: canonicalLang, isPartOf: { '@id': `${SITE}/#site` },
};
const crumbs = breadcrumb.length ? [{
  '@type': 'BreadcrumbList',
  itemListElement: [[t.ui.home.overview, '/'], ...breadcrumb].map(([name, href], index) => ({
    '@type': 'ListItem', position: index + 1, name, item: `${SITE}${localePath(canonicalLang, href)}`,
  })),
}] : [];
const subject = /^\/[0-5]$/.test(path) ? levels.find(l => `/${l.id}` === path) : undefined;
const extras = schema as Array<Record<string, unknown>>;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [website, ...(!extras.some(node => node['@id'] === page['@id']) ? [page] : []),
    termSet, ...(subject ? [term(subject)] : []), ...crumbs, ...schema],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
{alts.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={`${SITE}${localePath(DEFAULT_LANG, path)}`} />

{/* A number requires an explicit declaration by the publisher; the subject of a page is not its authorship level. */}
{level !== undefined && <>
  <meta name="ai-usage" content={String(level)} />
  <meta name="ai-usage-standard" content={SITE} />
  <link rel="ai-disclosure" href={`${SITE}/${level}`} />
</>}
{aiDisclosure && <meta name="ai-disclosure" content={aiDisclosure} />}
<meta name="ai-review-status" content="pending" />
{translated && t.translation && <meta name="ai-usage-translation"
  content={`source-language=en; method=${t.translation.by}; review=${t.translation.by === 'human' ? 'human-reviewed' : 'unreviewed'}`} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="AI Usage Scale" />
<meta property="og:locale" content={ogLocale(canonicalLang)} />
{alts.filter(a => a.lang !== canonicalLang).map(a => <meta property="og:locale:alternate" content={ogLocale(a.lang)} />)}
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="AI Usage Scale — six levels, 0 to 5" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="AI Usage Scale — six levels, 0 to 5" />
<meta name="robots" content={translated === false && lang !== DEFAULT_LANG ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
<link rel="alternate" type="application/json" href={`${SITE}${localePath(canonicalLang, '/levels.json')}`} title="AI Usage Scale vocabulary" />
<link rel="alternate" type="application/rss+xml" href={`${SITE}/feed.xml`} title="AI Usage Scale releases" />
<script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} is:inline />
