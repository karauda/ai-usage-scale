---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import { getLocale, localePath, DEFAULT_LANG } from '../lib/i18n';
import { VERSION } from '../lib/levels';

interface Props {
  lang?: string;
  path: string;
  title: string;
  description: string;
  card?: string;
  level?: number;
  aiDisclosure?: string;
  breadcrumb?: Array<[string, string]>;
  schema?: object[];
  translated?: boolean;
}
const { lang = DEFAULT_LANG, path, title, description, card, level, aiDisclosure,
  breadcrumb, schema, translated = true } = Astro.props;
const t = getLocale(lang);
const h = t.ui.home;
const L = (p: string) => localePath(lang, p);
const nav = [
  ['/', h.overview], ['/scale', t.ui.nav.scale], ['/find-your-level', t.ui.nav.level],
  ['/badges', t.ui.nav.badges], ['/spec', t.ui.nav.spec],
] as const;
---

<!doctype html>
<html lang={translated === false ? DEFAULT_LANG : lang} dir={translated === false ? 'ltr' : t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo lang={lang} path={path} title={title} description={description} card={card}
      level={level} aiDisclosure={aiDisclosure} breadcrumb={breadcrumb} schema={schema} translated={translated} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.dataset.js = '';
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip" lang={lang} dir={t.dir}>{h.skip}</a>
    <div class="shell">
      <header class="masthead" lang={lang} dir={t.dir}>
        <a href={L('/')} class="wordmark" aria-label="AI Usage Scale">
          <span class="wordmark-symbol" dir="ltr" aria-hidden="true">[ai]</span>
          <span class="wordmark-text" lang="en" dir="ltr">AI Usage<br />Scale</span>
        </a>
        <nav aria-label={h.primary}>
          {nav.map(([href, text]) => <a href={L(href)} aria-current={path === href ? 'page' : undefined}>{text}</a>)}
        </nav>
        <div class="chrome">
          <button type="button" class="theme-toggle" data-theme-toggle aria-label={h.theme}>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
          </button>
          <LangSwitcher lang={lang} path={path} />
        </div>
      </header>
      <main id="main" tabindex="-1">
        {translated === false && lang !== DEFAULT_LANG && <p class="reference-notice" lang={lang} dir={t.dir}>{h.englishReference}</p>}
        <slot />
      </main>
      <footer class="foot" lang={lang} dir={t.dir}>
        <div class="cols">
          <div>
            <p class="foot-brand"><strong lang="en">AI Usage Scale</strong> <span class="mono">/ {VERSION}</span></p>
            <p>{h.status}</p>
            <p>{t.ui.foot.licence}</p>
          </div>
          <div>
            <p class="label">{t.ui.foot.spec}</p>
            <div><a href={L('/scale')}>{t.ui.level.allLevels}</a></div>
            <div><a href={L('/spec')}>{t.ui.foot.spec}</a></div>
            <div><a href={L('/levels.json')}>levels.json</a></div>
            <div><a href="/levels.schema.json">JSON Schema</a></div>
          </div>
          <div>
            <p class="label">{h.resources}</p>
            <div><a href={L('/project')}>{h.project}</a></div>
            <div><a href={L('/integrations')} lang="en">Integrations</a></div>
            <div><a href={L('/cases')} lang="en">Worked examples</a></div>
            <div><a href={L('/eu-ai-act')} lang="en">EU AI Act</a></div>
            <div><a href="https://github.com/karauda/ai-usage-scale">{t.ui.foot.source}</a></div>
          </div>
        </div>
        <p class="foot-note">{h.contentNote} <a href={L('/project')}>{h.project} <span class="arrow" aria-hidden="true">↗</span></a></p>
      </footer>
    </div>
    <script>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme || (systemDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; inset-inline-start: 0.75rem; top: 0.75rem; z-index: 50; padding: 0.7rem 1rem; background: var(--accent); color: var(--on-accent); font-size: 0.875rem; text-decoration: none; transform: translateY(-180%); }
  .skip:focus { transform: translateY(0); }
  main:focus { outline: none; }
</style>
