{
  "name": "usagescale-mcp",
  "version": "1.3.1",
  "description": "The AI Usage Scale as an MCP server — classify a work, look up a level, read the spec. Runs locally over stdio, no network.",
  "type": "module",
  "bin": {
    "usagescale-mcp": "server.js"
  },
  "files": [
    "server.js",
    "classify.js",
    "levels.json",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-disclosure",
    "ai-usage-scale",
    "ai-transparency",
    "content-provenance"
  ],
  "homepage": "https://usagescale.org/integrations",
  "repository": {
    "type": "git",
    "url": "https://github.com/karauda/ai-usage-scale",
    "directory": "mcp"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "scripts": {
    "test": "node test.mjs",
    "test:server": "node test-server.mjs",
    "sync": "cp ../spec/levels.json ./levels.json",
    "prepack": "npm run sync && npm test",
    "prepublishOnly": "npm run test:server"
  }
}
