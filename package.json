{
  "name": "ai-usage-scale",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "An independent, open vocabulary for declaring generative AI use, human contribution and review.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "badges": "node scripts/build-badges.mjs",
    "build": "npm run badges && npm run og && astro build",
    "preview": "astro preview",
    "test": "node scripts/test.mjs && node mcp/test.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "check": "astro check",
    "og": "node scripts/build-og.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run check && npm run build && npm test && npm run check:dist"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "opentype.js": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
